PORT=3000
# Hosted SQLite database on Turso (used online). Leave both empty to use a local file instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local SQLite file, used only when TURSO_DATABASE_URL is empty.
DB_FILE=./data/records.db
# Comma-separated browser origins allowed to read the API (no path, no final slash).
CLIENT_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5508
